# Client ID de la aplicación web registrada en Microsoft Entra
MICROSOFT_CLIENT_ID=00000000-0000-0000-0000-000000000000
# Client secret Value; guárdalo solo en .env del servidor (no lo publiques)
MICROSOFT_CLIENT_SECRET=replace-with-secret-value
# URL base pública del servidor, sin barra final
PUBLIC_BASE_URL=http://localhost:8000
# Clave aleatoria estable para firmar sesiones y cifrar el secreto TOTP (mínimo 32 caracteres)
SESSION_SECRET=replace-with-long-random-session-secret
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
# Orígenes frontend exactos separados por comas (vacío = mismo origen)
CORS_ORIGINS=
# Credenciales del panel administrativo del proyecto
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-at-least-16-random-characters
# microsoft usa Microsoft; development simula la respuesta y solo funciona con PUBLIC_BASE_URL local
AUTH_MODE=development
MOCK_PROFILE_NAME=PruebaMinecraft
MOCK_PROFILE_UUID=12345678-1234-4234-8234-123456789abc
# Cliente de prueba local: copia aquí las credenciales que te muestre /admin
DEMO_API_BASE_URL=http://127.0.0.1:8000
DEMO_CALLBACK_URL=http://127.0.0.1:8001/callback
DEMO_CLIENT_ID=cl_copy-client-id-here
DEMO_CLIENT_SECRET=replace-with-client-secret
DEMO_SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# Opcional: ruta de la base SQLite (por defecto, clients.sqlite3 junto al código)
# CLIENTS_DB_PATH=./data/clients.sqlite3
